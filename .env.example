# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/campus-action-engine

# Frontend (used for CORS and post-login redirects)
CLIENT_URL=http://localhost:3000

# --- Google OAuth (Phase 2) ---
# From Google Cloud Console > APIs & Services > Credentials
# (see README "Google Cloud Setup" section for step-by-step instructions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AES-256-GCM key used to encrypt stored Google tokens at rest.
# Must be a 64-character hex string (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Application session cookie (not Google's own tokens)
SESSION_COOKIE_NAME=cae_session
SESSION_TTL_DAYS=7

# Set to "true" to make Gmail/Classroom/Drive endpoints return canned
# sample data instead of calling real Google APIs - useful before you
# have Google Cloud credentials set up. Leave unset/false otherwise.
GOOGLE_MOCK_MODE=false

# --- AI extractor: Gemini API free tier (recommended) ---
# Save a COPY of this file as backend/.env (not .env.txt).
# Gemini API keys come from Google AI Studio, not OpenAI.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Choose a model listed for your project in Google AI Studio.
# This newer Flash-Lite model has a free tier; older 2.5 models can be limited
# on newly created projects.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Throttle to about 4 requests per minute. Tune for your project's quotas.
GEMINI_MIN_REQUEST_INTERVAL_MS=16000
# Local safety settings: below the 5 RPM / 20 RPD shown in the sample logs.
# Actual project/model limits may differ; Google AI Studio is authoritative.
GEMINI_MAX_REQUESTS_PER_MINUTE=4
GEMINI_DAILY_REQUEST_BUDGET=12
# Process up to 24 items per sync in groups of four per Gemini request.
GEMINI_MAX_ITEMS_PER_SYNC=24
GEMINI_BATCH_SIZE=4

# Only needed if you deliberately select AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set true to use the offline rule-based extractor, without any AI API call.
# Legacy OPENAI_MOCK_MODE=true remains supported as an alias.
AI_MOCK_MODE=false

# --- Realtime + Automation (Phase 4) ---
# Socket.IO reuses CLIENT_URL (CORS) and the same session cookie as the
# REST API - no separate config needed.
# MCP (mounted at /mcp) reuses the same session cookie auth too.

# Standard cron expression for the deadline-check job (node-cron syntax).
# Default: every 15 minutes.
DEADLINE_CRON_SCHEDULE=*/15 * * * *

# Set to "false" to disable the scheduled deadline job entirely.
ENABLE_DEADLINE_CRON=true
